{
  "name": "eric-profile",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint app components lib scripts/*.ts tests --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "security:source": "node scripts/check-public-source.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write app components lib tests/*.ts scripts/*.ts next.config.ts tsconfig.json",
    "format:check": "prettier --check app components lib tests/*.ts scripts/*.ts next.config.ts tsconfig.json",
    "data:migrate": "node scripts/migrate-cloud.ts",
    "admin:create": "node scripts/create-admin.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-youtube": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@vercel/blob": "^2.8.1",
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "next": "^16.4.0",
    "pdfjs-dist": "^6.4.299",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
