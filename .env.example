# Local default: http://localhost:3001
# Production: set the exact HTTPS origin; do not include a trailing slash.
PUBLIC_ORIGIN=http://localhost:3001
# Keep this directory on a persistent volume, outside application releases.
DATA_DIR=.data

# Vercel: provision a Neon database and a PRIVATE Vercel Blob store.
# Server-only secrets; never use NEXT_PUBLIC_ prefixes.
# DATABASE_URL=postgresql://... (Neon pooled connection, TLS required)
# BLOB_READ_WRITE_TOKEN=...
# GITHUB_CREDENTIAL_KEY=... (64 random hexadecimal characters; retain across redeploys)
# PUBLIC_ORIGIN=https://ericisme.cloud
# BACKUP_ENCRYPTION_KEY=... (separate 64 random hex characters; keep a recovery copy)
# CRON_SECRET=... (random scheduler authentication secret)
# ADMIN_PASSWORD is used only by npm run admin:create.
# Supply it via your secret manager or enter a password in the terminal.
# Never commit an actual password.

# Optional server-only GitHub token for higher public API limits.
# Never prefix this with NEXT_PUBLIC_ or commit a real token.
# GITHUB_TOKEN=


